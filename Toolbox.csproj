<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="tools.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyToolsToOutput" AfterTargets="Build">
    <ItemGroup>
      <ToolsForOutput Include="$(MSBuildProjectDirectory)\Tools\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ToolsForOutput)" DestinationFiles="@(ToolsForOutput->'$(OutputPath)Tools\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyToolsToPublish" AfterTargets="Publish">
    <ItemGroup>
      <ToolsForPublish Include="$(MSBuildProjectDirectory)\Tools\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ToolsForPublish)" DestinationFiles="@(ToolsForPublish->'$(PublishDir)Tools\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>